# Antigravity Platform Configuration

# Environment
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/antigravity

# Security
SECRET_KEY=change_me_to_a_random_secret_key_of_at_least_32_chars

# Groq AI
GROQ_API_KEY=your_groq_api_key

GROQ_MODEL=llama-3.3-70b-versatile

# GitHub App/OAuth Integration
GITHUB_TOKEN=ghp_your_github_token
GITHUB_WEBHOOK_SECRET=your_webhook_secret
GITHUB_CLIENT_ID=your_oauth_client_id
GITHUB_CLIENT_SECRET=your_oauth_client_secret
